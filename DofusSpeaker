        try:
            keyboard.add_hotkey('ctrl+shift+s', self.toggle_speak_hotkey)
        except Exception:
            pass

    # ----- UI helpers -----
    def set_voice_controls_state(self, state: str):
        self.voice_cb.configure(state="readonly" if state == "normal" else "disabled")
        self.model_entry.configure(state=state)
        self.apply_btn.configure(state=state)
        self.test_btn.configure(state=state)
        self.beep_btn.configure(state=state)
        self.male_voice_cb.configure(state="readonly" if state == "normal" else "disabled")
        self.female_voice_cb.configure(state="readonly" if state == "normal" else "disabled")

    def update_worker_voices(self):
        if self.worker:
            self.worker.male_voice = self.male_voice_var.get()
            self.worker.female_voice = self.female_voice_var.get()

    def apply_api_key(self):
        key = self.key_var.get().strip()
        if not key:
            self.err_var.set("API key is empty.")
            return
        if self.speaker is None:
            try:
                persist_dir = TTS_CACHE_DIR if self.save_wav_var.get() else None
                self.speaker = OpenAITTSSpeaker(api_key=key,
                                                model=self.model_var.get(),
                                                voice=self.voice_var.get(),
                                                persist_dir=persist_dir)
                self.worker.speaker = self.speaker
                self.status_var.set("OpenAI TTS ready")
                self.set_voice_controls_state("normal")
                self.err_var.set("")
            except Exception as e:
                self.status_var.set(f"⚠️ TTS init error: {e}")
                self.err_var.set(str(e))
        else:
            self.speaker.set_api_key(key)
            self.status_var.set("API key updated for current session.")
            self.err_var.set("")

    def on_save_wav_toggle(self):
        if not self.speaker:
            return
        if self.save_wav_var.get():
            try:
                os.makedirs(TTS_CACHE_DIR, exist_ok=True)
            except Exception as e:
                self.err_var.set(f"Cannot create folder: {e}")
                return
            self.speaker.set_persist_dir(TTS_CACHE_DIR)
            self.status_var.set(f"Saving WAVs to {TTS_CACHE_DIR}")
        else:
            self.speaker.set_persist_dir(None)
            self.status_var.set("WAV saving disabled")

    def open_wav_folder(self):
        try:
            os.makedirs(TTS_CACHE_DIR, exist_ok=True)
            subprocess.Popen(["explorer", TTS_CACHE_DIR])
        except Exception as e:
            self.err_var.set(f"Open folder failed: {e}")

    def toggle_speak_hotkey(self):
        self.enabled_var.set(not self.enabled_var.get())
        self.on_enabled_toggle()

    def on_enabled_toggle(self):
        self.worker.enabled = self.enabled_var.get()
        self.status_var.set(f"Speaking {'enabled' if self.worker.enabled else 'disabled'}")

    def on_unknown_toggle(self):
        self.worker.speak_unknown = self.spk_unknown_var.get()
        self.status_var.set(f"Speak unknown: {'ON' if self.worker.speak_unknown else 'OFF'}")

    def apply_voice_model(self):
        if not self.speaker:
            return
        v = self.voice_var.get().strip()
        m = self.model_var.get().strip()
        if v in OPENAI_VOICES:
            self.speaker.set_voice(v)
        self.speaker.set_model(m or OPENAI_DEFAULT_MODEL)
        self.status_var.set(f"Voice set to '{self.speaker.voice}', model '{self.speaker.model}'")

    def on_test(self):
        if not self.speaker:
            self.err_var.set("No TTS backend. Provide API key.")
            return
        msg = f"Test voix {self.speaker.voice}. Bonjour, ceci est un test."
        self.speaker.speak(msg)

    def on_beep(self):
        try:
            winsound.Beep(880, 180)
            winsound.Beep(660, 180)
        except Exception as e:
            self.err_var.set(f"Beep failed: {e}")

    def poll_tts_status(self):
        if self.speaker:
            if self.speaker.last_error:
                self.err_var.set(self.speaker.last_error[:300])
            else:
                self.err_var.set("")
            if self.speaker.last_path:
                self.tts_info_var.set(f"Last WAV: {self.speaker.last_path} ({self.speaker.last_size} bytes)")
        else:
            self.tts_info_var.set("")
        self.root.after(900, self.poll_tts_status)

    def pump_ui(self):
        try:
            while True:
                msg = self.ui_queue.get_nowait()
                if "status" in msg:
                    self.status_var.set(msg["status"])
                if "text_preview" in msg:
                    self.text_var.set(msg["text_preview"] or "(waiting for dialogue)")
                if "spoken" in msg:
                    self.status_var.set(f"Speaking: {msg['spoken'][:80]}{'…' if len(msg['spoken'])>80 else ''}")
        except queue.Empty:
            pass
        self.root.after(120, self.pump_ui)

    def on_close(self):
        try:
            self.worker.stop()
        except Exception:
            pass
        try:
            if hasattr(self.speaker, "stop"):
                self.speaker.stop()
        except Exception:
            pass
        try:
            keyboard.unhook_all_hotkeys()
        except Exception:
            pass
        self.root.destroy()

# =========================================================
def main():
    app = App()
    app.root.mainloop()

if __name__ == "__main__":
    main()
