        self.male_voice_cb.bind("<<ComboboxSelected>>", lambda e: self.update_worker_voices())
        self.female_voice_cb.bind("<<ComboboxSelected>>", lambda e: self.update_worker_voices())
        self.voice_cb.bind("<<ComboboxSelected>>", lambda e: self.apply_voice_model())

        # UI timers & close protocol
        self.root.after(120, self.pump_ui)
        self.root.after(600, self.poll_tts_status)
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)

